# Supabase project settings (Project Settings -> API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret - required in the Authorization header (Bearer <token>) for every
# API call, whether it comes from the app in your browser or from Claude.
# Generate any long random string, e.g.: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Web Push VAPID keys - generate with: npx web-push generate-vapid-keys
# Same public key value goes in both of these (one is for the server, one is
# exposed to the browser - NEXT_PUBLIC_ vars are the only ones Next.js sends
# to client-side code).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aelamra25@gmail.com
